generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Call {
  id                 String   @id @default(uuid()) @db.Uuid
  callId             String   @unique @map("call_id")
  phoneNumber        String   @map("phone_number")
  agent              String
  durationSeconds    Int      @map("duration_seconds")
  recordingUrl       String   @map("recording_url")
  isSpam             Boolean  @default(false) @map("is_spam")
  isRepeatCaller     Boolean  @default(false) @map("is_repeat_caller")
  previousCallsCount Int      @default(0) @map("previous_calls_count")
  receivedAt         DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@index([phoneNumber, receivedAt])
  @@index([agent])
  @@index([receivedAt])
  @@map("calls")
}
